<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-staff" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="staff"/>
            </not>
        </preConditions>

        <createTable tableName="staff">
            <column name="staff_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="phone" type="varchar(20)">
                <constraints unique="true"/>
            </column>
            <column name="password_hash" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="002-create-client" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="client"/>
            </not>
        </preConditions>

        <createTable tableName="client">
            <column name="client_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="varchar(20)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="email" type="varchar(100)"/>
            <column name="delivery_address" type="varchar(500)"/>
            <column name="password_hash" type="text"/>
            <column name="created_at" type="timestamp"/>
        </createTable>

    </changeSet>

    <changeSet id="003-create-restaurant-table" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="restaurant_table"/>
            </not>
        </preConditions>

        <createTable tableName="restaurant_table">
            <column name="table_id" type="integer" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="number" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="capacity" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="pos_x" type="integer"/>
            <column name="pos_y" type="integer"/>
            <column name="status" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="004-create-reservation" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="reservation"/>
            </not>
        </preConditions>

        <createTable tableName="reservation">
            <column name="reservation_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="table_id" type="integer">
                <constraints nullable="false"
                             foreignKeyName="fk_reservation_table"
                             references="restaurant_table(table_id)"/>
            </column>
            <column name="staff_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_reservation_staff"
                             references="staff(staff_id)"/>
            </column>
            <column name="guest_name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="guest_phone" type="varchar(20)"/>
            <column name="persons" type="integer">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="text"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="005-create-menu-category" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="menu_category"/>
            </not>
        </preConditions>

        <createTable tableName="menu_category">
            <column name="menu_category_id" type="integer" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="006-create-menu-item" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="menu_item"/>
            </not>
        </preConditions>

        <createTable tableName="menu_item">
            <column name="menu_item_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="menu_category_id" type="integer">
                <constraints nullable="false"
                             foreignKeyName="fk_menu_item_category"
                             references="menu_category(menu_category_id)"/>
            </column>
            <column name="name" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="text"/>
            <column name="price" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="photo_url" type="text"/>
            <column name="type" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="is_available" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

    </changeSet>

    <changeSet id="007-create-orders" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="orders"/>
            </not>
        </preConditions>

        <createTable tableName="orders">
            <column name="order_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="type" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="table_id" type="integer">
                <constraints foreignKeyName="fk_orders_table"
                             references="restaurant_table(table_id)"/>
            </column>
            <column name="client_id" type="bigint">
                <constraints foreignKeyName="fk_orders_client"
                             references="client(client_id)"/>
            </column>
            <column name="staff_id" type="bigint">
                <constraints foreignKeyName="fk_orders_staff"
                             references="staff(staff_id)"/>
            </column>
            <column name="delivery_address" type="text"/>
            <column name="payment_method" type="varchar(10)"/>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="total_amount" type="bigint"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="closed_at" type="timestamp"/>
        </createTable>

    </changeSet>

    <changeSet id="008-create-order-item" author="AinLume">

        <preConditions>
            <not>
                <tableExists tableName="order_item"/>
            </not>
        </preConditions>

        <createTable tableName="order_item">
            <column name="order_item_id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="order_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_order_item_order"
                             references="orders(order_id)"/>
            </column>
            <column name="menu_item_id" type="bigint">
                <constraints nullable="false"
                             foreignKeyName="fk_order_item_menu_item"
                             references="menu_item(menu_item_id)"/>
            </column>
            <column name="quantity" type="integer"/>
            <column name="comment" type="text"/>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="destination" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    
</databaseChangeLog>